include "/etc/bind/keys/esclavo.key";

zone "empresa.local" {
        type master;
        file "/etc/bind/db.empresa.local";

        notify yes;
        also-notify {
                192.168.50.3 key "esclavo-key";
        };

        allow-transfer {
                key "esclavo-key";
        };

        ixfr-from-differences yes;
};

zone "50.168.192.in-addr.arpa" {
        type master;
        file "/etc/bind/db.192.168.50";

        notify yes;
        also-notify {
                192.168.50.3 key "esclavo-key";
        };

        allow-transfer {
                key "esclavo-key";
        };

        ixfr-from-differences yes;
};

logging {

        channel queries_log {
                file "/var/log/named/queries.log";
                severity info;
                print-time yes;
        };

        channel transfers_log {
                file "/var/log/named/transfers.log";
                severity info;
                print-time yes;
        };

        channel security_log {
                file "/var/log/named/security.log";
                severity info;
                print-time yes;
        };

        category queries {
                queries_log;
        };

        category xfer-in {
                transfers_log;
        };

        category xfer-out {
                transfers_log;
        };

        category notify {
                transfers_log;
        };

        category security {
                security_log;
        };
};
