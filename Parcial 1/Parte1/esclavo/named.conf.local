include "/etc/bind/keys/esclavo.key";

zone "empresa.local" {
        type slave;
        masters {
                192.168.50.2 key "esclavo-key";
        };
        file "/var/cache/bind/db.empresa.local";
};

zone "50.168.192.in-addr.arpa" {
        type slave;
        masters {
                192.168.50.2 key "esclavo-key";
        };
        file "/var/cache/bind/db.192.168.50";
};

logging {

        channel queries_log {
                file "/var/log/named/queries.log";
                severity info;
                print-time yes;
        };

        channel transfers_log {
                file "/var/log/named/transfers.log";
                severity info;
                print-time yes;
        };

        channel security_log {
                file "/var/log/named/security.log";
                severity info;
                print-time yes;
        };

        category queries {
                queries_log;
        };

        category xfer-in {
                transfers_log;
        };

        category xfer-out {
                transfers_log;
        };

        category notify {
                transfers_log;
        };

        category security {
                security_log;
        };
};
