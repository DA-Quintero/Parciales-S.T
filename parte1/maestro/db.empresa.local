$TTL    86400
@       IN      SOA     ns1.empresa.local. admin.empresa.local. (
                        2026090503      ; Serial (AAAAMMDDNN)
                        3600            ; Refresh: 1h
                        900             ; Retry: 15min
                        604800          ; Expiry: 7 dias
                        86400 )         ; Minimum: 1 dia

        IN      NS      ns1.empresa.local.
        IN      NS      ns2.empresa.local.
        IN      MX      10      mail.empresa.local.

ns1     IN      A       192.168.50.2
ns1     IN      AAAA    fd00:50::2
ns2     IN      A       192.168.50.3
ns2     IN      AAAA    fd00:50::3

www     IN      A       192.168.50.10
www     IN      AAAA    fd00:50::10
parcial IN      A       192.168.50.2
mail    IN      A       192.168.50.12
mail    IN      AAAA    fd00:50::11

ftp     IN      CNAME   www
