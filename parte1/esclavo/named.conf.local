include "/etc/bind/keys/esclavo.key";

zone "empresa.local" {
    type slave;
    file "/var/cache/bind/db.empresa.local";
    masters { 192.168.56.10 key esclavo-key; };
    allow-notify { 192.168.56.10; };
};

zone "56.168.192.in-addr.arpa" {
    type slave;
    file "/var/cache/bind/db.192.168.56";
    masters { 192.168.56.10 key esclavo-key; };
    allow-notify { 192.168.56.10; };
};


# Zona directa esclava: recibe copias del maestro autenticadas mediante TSIG
# type slave: indica que esta zona se sincroniza desde el servidor primario
# masters: IP del servidor maestro hacia el que se solicitan las transferencias AXFR/IXFR
